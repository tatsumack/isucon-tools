go install github.com/google/pprof@latest
# または go tool pprof でも可

```
_ "net/http/pprof"

func main() {
	// pprof
    go func() {
        log.Println(http.ListenAndServe("localhost:6060", nil))
    }()
```

//ベンチ実行直前に (バイナリのパスは当日のものに置き換える)
pprof -http=localhost:8080 /home/isucon/webapp/go/<binary> http://localhost:6060/debug/pprof/profile?seconds=60 &

//ベンチ後
pprof /home/isucon/webapp/go/<binary> /home/isucon/pprof/pprof.<binary>.samples.cpu.001.pb.gz
